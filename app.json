{
  "expo": {
    "name": "BikeTracker",
    "slug": "biketracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BikeTracker uses your location to record bicycle rides and show them on a map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "BikeTracker uses your location to record bicycle rides in the background while the app is mounted on your handlebar.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "WAKE_LOCK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "foregroundService": {
        "notification": {
          "title": "BikeTracker is recording your ride",
          "body": "Tracking your route in the background. Tap to return to the app.",
          "color": "#84CC16"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BikeTracker uses your location to record bicycle rides.",
          "locationAlwaysAndWhenInUsePermission": "BikeTracker uses your location to record bicycle rides in the background."
        }
      ],
      "expo-status-bar",
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "style": "dark",
          "enforceContrast": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "dark",
        "hidden": true
      },
      "eas": {
        "projectId": "b7f1c5c5-3efa-41b3-9b92-ea0a4553919a"
      }
    }
  }
}
